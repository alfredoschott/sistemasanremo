rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email;
    }

    function usuario() {
      return get(/databases/$(database)/documents/usuariosAutorizados/$(email()));
    }

    function autorizado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuariosAutorizados/$(email()));
    }

    function misRoles() {
      return usuario().data.roles;
    }

    // Subconjunto de misRoles() marcado como solo-ver (ver UsuariosPage /
    // actualizarRolesSoloLectura) — puede leer esas áreas pero no escribir
    // en ellas. Ausente en usuarios creados antes de que existiera el
    // campo, por eso el default a lista vacía.
    function misRolesSoloLectura() {
      return usuario().data.get('rolesSoloLectura', []);
    }

    // Los roles con los que sí puede escribir: los suyos, quitando los que
    // marcó como solo-ver.
    function misRolesEscritura() {
      return misRoles().removeAll(misRolesSoloLectura());
    }

    function esAdmin() {
      return autorizado() && ('admin' in misRoles());
    }

    // Esta cuenta nunca puede perder el rol de Admin ni ser eliminada —
    // coincide con CUENTA_PROTEGIDA en usuarioActions.js (esa es solo la
    // primera línea de defensa en la UI; esta regla es la que de verdad lo
    // impide, incluso si alguien escribe directo a Firestore).
    function esCuentaProtegida(correo) {
      return correo == 'sistemasanremo@gmail.com';
    }

    // true si el usuario tiene AL MENOS UNO de los roles dados (o es admin).
    // Varias colecciones las tocan más de un área en el flujo normal (ej.
    // Compras escribe en `cotizaciones` al abrir una OF, Producción también
    // al avanzarla) — por eso son listas, no un solo rol. Esto no es
    // permisos por campo (ver PROGRESS.md, limitación conocida): cualquiera
    // de los roles listados puede escribir cualquier campo del documento.
    function tieneAlgunRol(roles) {
      return autorizado() && (esAdmin() || misRoles().hasAny(roles));
    }

    // Igual que tieneAlgunRol, pero para escribir: si de los roles pedidos
    // solo tiene alguno marcado como solo-ver, puede leer pero no escribir.
    function puedeEscribir(roles) {
      return autorizado() && (esAdmin() || misRolesEscritura().hasAny(roles));
    }

    // Solo cada quien puede leer su propio documento (para saber sus roles
    // al entrar), y solo un admin puede leer la lista completa o modificar
    // el acceso/rol de cualquiera — incluido el suyo propio. Sobre la
    // cuenta protegida, ni siquiera un admin puede escribir algo que le
    // quite el rol "admin" o la borre (request.resource es null al
    // borrar, así que la condición también bloquea el delete).
    match /usuariosAutorizados/{userEmail} {
      allow read: if request.auth != null && (email() == userEmail || esAdmin());
      allow write: if esAdmin() &&
        (!esCuentaProtegida(userEmail) ||
          (request.resource != null && 'admin' in request.resource.data.roles));
    }

    match /cotizaciones/{id} {
      allow read: if tieneAlgunRol(['ventas', 'compras', 'produccion', 'finanzas']);
      allow write: if puedeEscribir(['ventas', 'compras', 'produccion', 'finanzas']);
    }

    match /notas/{id} {
      allow read: if tieneAlgunRol(['ventas', 'compras', 'produccion', 'finanzas']);
      allow write: if puedeEscribir(['ventas', 'compras', 'produccion', 'finanzas']);
    }

    match /auditoria/{id} {
      allow read: if tieneAlgunRol(['ventas', 'compras', 'produccion', 'finanzas']);
      allow write: if puedeEscribir(['ventas', 'compras', 'produccion', 'finanzas']);
    }

    match /ordenesFabricacion/{id} {
      allow read: if tieneAlgunRol(['compras', 'produccion']);
      allow write: if puedeEscribir(['compras', 'produccion']);
    }

    // Estándar de materiales por modelo (ver ListasMaterialesPage.jsx) —
    // Compras también lo lee al abrir una OF, para calcular
    // `materialesRequeridos` de esa orden.
    match /listasMateriales/{id} {
      allow read: if tieneAlgunRol(['compras', 'produccion']);
      allow write: if puedeEscribir(['compras', 'produccion']);
    }

    match /ordenesCompra/{id} {
      allow read: if tieneAlgunRol(['compras', 'finanzas']);
      allow write: if puedeEscribir(['compras', 'finanzas']);
    }

    match /proveedores/{id} {
      allow read: if tieneAlgunRol(['compras', 'finanzas']);
      allow write: if puedeEscribir(['compras', 'finanzas']);
    }

    // 'produccion' también escribe aquí: registrar consumo de materiales
    // en una OF resta stock real (ver stockActions.registrarConsumoMaterial).
    match /materiales/{id} {
      allow read: if tieneAlgunRol(['compras', 'almacen', 'produccion']);
      allow write: if puedeEscribir(['compras', 'almacen', 'produccion']);
    }

    match /movimientosAlmacen/{id} {
      allow read: if tieneAlgunRol(['compras', 'almacen', 'produccion']);
      allow write: if puedeEscribir(['compras', 'almacen', 'produccion']);
    }

    // 'produccion' también escribe aquí: al completar y facturar una OF,
    // sus transformadores pasan solos a este inventario (ver
    // completarYFacturar/deshacerCompletarYFacturar en ofActions.js).
    match /transformadoresTerminados/{id} {
      allow read: if tieneAlgunRol(['transformadores', 'produccion']);
      allow write: if puedeEscribir(['transformadores', 'produccion']);
    }

    // Bajo riesgo (solo mensajes + link) y cruza todas las áreas — se
    // genera desde casi cualquier acción de negocio. Cualquier persona
    // autorizada la puede leer/marcar leída.
    match /notificaciones/{id} {
      allow read, write: if autorizado();
    }

    // Copia mínima y pública de cada cotización (mismo id que el
    // documento real), para que el cliente vea su estatus con un link,
    // sin necesitar cuenta — ver src/lib/seguimientoPublico.js y
    // src/modules/seguimiento/SeguimientoPage.jsx. A propósito NO exige
    // auth para leer: es el único punto de todo el sistema pensado para
    // gente de fuera de la empresa. Por eso vive en su propia colección
    // con solo cliente/estado/avance/entrega/items(modelo+cantidad, sin
    // precio) — nunca montos, materiales ni nada más del resto de
    // `cotizaciones`. Escribir sigue restringido a los mismos
    // roles que ya tocan el ciclo de vida de una cotización.
    match /seguimientoPublico/{id} {
      allow read: if true;
      allow write: if puedeEscribir(['ventas', 'compras', 'produccion', 'finanzas']);
    }
  }
}
