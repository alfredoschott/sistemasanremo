rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuariosAutorizados/$(request.auth.token.email));
    }

    // Acceso restringido a la lista en /usuariosAutorizados (agregar
    // correos con scripts/agregarUsuario.mjs). Roles por área
    // (Ventas/Compras/Producción/Almacén) siguen pendientes de definir
    // con Sanremo — ver CLAUDE.md.
    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
